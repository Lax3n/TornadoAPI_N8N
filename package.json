{
  "name": "n8n-nodes-tornado-api",
  "version": "1.3.2",
  "description": "n8n node for Tornado API - Download TBs of YouTube videos & Spotify podcasts with advanced features",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "tornado",
    "video",
    "downloader",
    "youtube",
    "spotify",
    "podcast",
    "mp4",
    "mp3",
    "dashboard",
    "live-stream",
    "clipping"
  ],
  "license": "MIT",
  "homepage": "https://api.tornadoapi.io",
  "author": {
    "name": "Velys Software",
    "email": "support@velys.software"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Lax3n/TornadoAPI_N8N.git"
  },
  "main": "index.js",
  "scripts": {
    "build": "n8n-node build",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials --write",
    "lint": "n8n-node lint",
    "lintfix": "n8n-node lint --fix",
    "test": "n8n-node lint",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/TornadoApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/TornadoApi/TornadoApi.node.js",
      "dist/nodes/TornadoApi/TornadoApiTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.21.0",
    "@types/node": "^20.10.0",
    "eslint": "^9.39.3",
    "gulp": "^5.0.1",
    "n8n-workflow": "^2.10.0",
    "prettier": "^3.1.0",
    "typescript": "^5.3.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
